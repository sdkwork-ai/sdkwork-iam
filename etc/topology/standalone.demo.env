# Isolated demo environment (standalone.demo).
# Independent database schema: sdkwork_iam_demo
# Independent Redis prefix: iam-demo (logical DB index 9) to avoid sharing conflicts on a shared Redis.
SDKWORK_IAM_DEPLOYMENT_PROFILE=standalone
SDKWORK_IAM_ENVIRONMENT=demo
SDKWORK_IAM_PROFILE_ID=standalone.demo
SDKWORK_IAM_APPLICATION_PUBLIC_HTTP_URL=https://iam-demo.sdkwork.com
