# Isolated demo environment (standalone.demo).
# Independent database schema: sdkwork_iam_demo
# Independent Redis prefix: iam-demo (logical DB index 9) to avoid sharing conflicts on a shared Redis.
SDKWORK_IAM_DEPLOYMENT_PROFILE=standalone
SDKWORK_IAM_ENVIRONMENT=demo
SDKWORK_IAM_PROFILE_ID=standalone.demo
SDKWORK_IAM_APPLICATION_PUBLIC_HTTP_URL=https://iam-demo.sdkwork.com
SDKWORK_IAM_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3901


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_IAM_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_CORS_ALLOWED_ORIGINS=https://iam-demo.sdkwork.com,http://iam-demo.sdkwork.com,https://iam-demo.birdcoder.com,http://iam-demo.birdcoder.com,https://iam-demo.dtupay.com,http://iam-demo.dtupay.com,https://iam-demo.noaper.com,http://iam-demo.noaper.com,https://iam-demo.sdkwork.cn,http://iam-demo.sdkwork.cn,https://iam-demo.birdcoder.cn,http://iam-demo.birdcoder.cn,https://iam-demo.dtupay.cn,http://iam-demo.dtupay.cn,https://iam-demo.noaper.cn,http://iam-demo.noaper.cn,https://iam-demo.skubc.com,http://iam-demo.skubc.com,https://iam-demo.skubc.cn,http://iam-demo.skubc.cn,https://iam-demo.zowalk.com,http://iam-demo.zowalk.com,https://iam-demo.zowalk.cn,http://iam-demo.zowalk.cn,https://iam-demo.offer86.com,http://iam-demo.offer86.com,https://iam-demo.offer86.cn,http://iam-demo.offer86.cn,https://iam-demo.86offer.com,http://iam-demo.86offer.com,https://iam-demo.86offer.cn,http://iam-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
