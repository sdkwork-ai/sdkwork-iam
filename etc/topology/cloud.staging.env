# Bootstrap profile cloud.staging — replace with application-specific values.
SDKWORK_IAM_DEPLOYMENT_PROFILE=cloud
SDKWORK_IAM_ENVIRONMENT=staging
SDKWORK_IAM_PROFILE_ID=cloud.staging
SDKWORK_IAM_APPLICATION_PUBLIC_HTTP_URL=https://iam-staging.sdkwork.com
