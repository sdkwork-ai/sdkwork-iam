# Bootstrap profile standalone.staging — replace with application-specific values.
SDKWORK_IAM_DEPLOYMENT_PROFILE=standalone
SDKWORK_IAM_ENVIRONMENT=staging
SDKWORK_IAM_PROFILE_ID=standalone.staging
SDKWORK_IAM_APPLICATION_PUBLIC_HTTP_URL=https://iam-staging.sdkwork.com
SDKWORK_IAM_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3901


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_IAM_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
