<view class="page">
  <view class="brand">
    <text class="brand-title">{{title}}</text>
  </view>

  <view wx:if="{{done}}" class="card">
    <text class="notice">{{doneText}}</text>
    <button class="primary" bindtap="onBackToLogin">{{toLoginText}}</button>
    <view class="links">
      <text class="link" bindtap="onRegisterAgain">{{registerAgainText}}</text>
    </view>
  </view>

  <view wx:else class="card">
    <view class="field">
      <text class="label">账号</text>
      <input class="input" placeholder="手机号或邮箱" value="{{account}}" bindinput="onAccountInput" />
    </view>

    <view class="field">
      <text class="label">验证码</text>
      <view class="code-row">
        <input
          class="input code-input"
          placeholder="请输入验证码"
          value="{{code}}"
          bindinput="onCodeInput"
        />
        <button
          class="code-button"
          disabled="{{sending || !account}}"
          loading="{{sending}}"
          bindtap="onSendCode"
        >
          {{sendCodeText}}
        </button>
      </view>
    </view>

    <view class="field">
      <text class="label">密码</text>
      <input class="input" password placeholder="至少 8 位" value="{{password}}" bindinput="onPasswordInput" />
    </view>
    <view class="field">
      <text class="label">确认密码</text>
      <input class="input" password placeholder="再次输入密码" value="{{confirm}}" bindinput="onConfirmInput" />
    </view>

    <text wx:if="{{errorText}}" class="error">{{errorText}}</text>

    <button
      class="primary"
      disabled="{{pending || !account || !code || !password || !confirm}}"
      loading="{{pending}}"
      bindtap="onSubmit"
    >
      {{pending ? pendingText : title}}
    </button>

    <view class="links">
      <text class="link" bindtap="onBackToLogin">{{toLoginText}}</text>
    </view>
  </view>
</view>
