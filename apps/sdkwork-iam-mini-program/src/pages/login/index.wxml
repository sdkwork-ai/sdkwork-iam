<view class="page auth-page">
  <view class="brand auth-brand">
    <text class="brand-title">{{title}}</text>
  </view>

  <view class="auth-content">
    <button
      class="wechat-button"
      disabled="{{pending}}"
      loading="{{pendingMode === 'wechat'}}"
      bindtap="onWechatLogin"
    >
      {{wechatText}}
    </button>

    <view class="divider"><text>{{orText}}</text></view>

    <view class="card auth-card">
      <view class="field">
        <text class="label" id="account-label">{{accountLabel}}</text>
        <input
          class="input"
          type="text"
          confirm-type="next"
          maxlength="254"
          placeholder="{{accountPlaceholder}}"
          value="{{account}}"
          aria-labelledby="account-label"
          bindinput="onAccountInput"
        />
      </view>
      <view class="field">
        <text class="label" id="password-label">{{passwordLabel}}</text>
        <view class="password-row">
          <input
            class="input password-input"
            password="{{!passwordVisible}}"
            confirm-type="done"
            maxlength="128"
            placeholder="{{passwordPlaceholder}}"
            value="{{password}}"
            aria-labelledby="password-label"
            bindinput="onPasswordInput"
            bindconfirm="onSubmit"
          />
          <button
            class="password-toggle"
            hover-class="none"
            aria-label="{{passwordVisibilityText}}"
            bindtap="onTogglePassword"
          >
            {{passwordVisible ? hidePasswordText : showPasswordText}}
          </button>
        </view>
      </view>

      <text wx:if="{{errorText}}" class="error" role="alert" aria-live="assertive">{{errorText}}</text>

      <button
        class="primary"
        disabled="{{pending || !account || !password}}"
        loading="{{pendingMode === 'password'}}"
        bindtap="onSubmit"
      >
        {{pendingMode === 'password' ? pendingText : actionText}}
      </button>

      <view class="links">
        <button class="link" hover-class="none" bindtap="onRegister">{{toRegister}}</button>
        <button class="link" hover-class="none" bindtap="onForgot">{{toForgot}}</button>
      </view>
    </view>
  </view>
</view>
