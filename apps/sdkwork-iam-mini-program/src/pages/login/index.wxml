<view class="page">
  <view class="brand">
    <text class="brand-title">{{title}}</text>
  </view>

  <view class="card">
    <view class="field">
      <text class="label">账号</text>
      <input
        class="input"
        placeholder="手机号或邮箱"
        value="{{account}}"
        bindinput="onAccountInput"
      />
    </view>
    <view class="field">
      <text class="label">密码</text>
      <input
        class="input"
        password
        placeholder="请输入密码"
        value="{{password}}"
        bindinput="onPasswordInput"
      />
    </view>

    <text wx:if="{{errorText}}" class="error">{{errorText}}</text>

    <button
      class="primary"
      disabled="{{pending || !account || !password}}"
      loading="{{pending}}"
      bindtap="onSubmit"
    >
      {{pending ? pendingText : actionText}}
    </button>

    <view class="links">
      <text class="link" bindtap="onRegister">{{toRegister}}</text>
      <text class="link" bindtap="onForgot">{{toForgot}}</text>
    </view>
  </view>
</view>
