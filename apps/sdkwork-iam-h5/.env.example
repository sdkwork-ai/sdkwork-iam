# SDKWork IAM H5 public browser runtime environment.
# Copy to `.env.local` (gitignored) and adjust for local development.
# VITE_* variables are public non-secret build/dev inputs only.
# Secrets, tokens, refresh tokens, and private service endpoints MUST NOT live here.
#
# Standalone development defaults point at the local IM gateway (18089).
# Regenerate per-profile values with `pnpm workflow:materialize-client-env`.

# Deployment profile: standalone | cloud
VITE_SDKWORK_DEPLOYMENT_PROFILE=standalone

# IM application public HTTP base URL (browser-facing).
VITE_SDKWORK_IAM_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:18089

# IM realtime WebSocket base URL (browser-facing). The IM SDK connects the CCP
# endpoint at `{wsBase}/im/v3/api/realtime/ws`; this must point at the IM
# gateway, not the frontend dev server.
VITE_SDKWORK_IAM_APPLICATION_PUBLIC_WEBSOCKET_URL=ws://127.0.0.1:18089

# IM platform API gateway HTTP URL (browser-facing).
VITE_SDKWORK_IAM_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:18089

# IM app SDK base URL.
VITE_SDKWORK_IAM_API_BASE_URL=http://127.0.0.1:18089

# Drive app SDK base URL.
VITE_SDKWORK_DRIVE_APP_API_BASE_URL=http://127.0.0.1:18089

# IAM API base URL.
VITE_SDKWORK_IAM_API_BASE_URL=http://127.0.0.1:18089

# Voice app SDK base URL (sdkwork-voice app-api). Defaults to the platform
# gateway; point at the standalone voice runtime for local development.
# VITE_SDKWORK_VOICE_APP_API_BASE_URL=http://127.0.0.1:18096

# Optional H5 module composition. Omit to keep the release default: chat,notary.
# Only modules with completed runtime contracts may be selected.
# VITE_SDKWORK_IAM_H5_MODULES=chat,notary,contacts,drive

# Optional auth development prefill (local development only).
# VITE_SDKWORK_IAM_AUTH_DEV_DEFAULT_ACCOUNT=
# VITE_SDKWORK_IAM_AUTH_DEV_DEFAULT_EMAIL=
# VITE_SDKWORK_IAM_AUTH_DEV_DEFAULT_PHONE=
# VITE_SDKWORK_IAM_AUTH_DEV_DEFAULT_PASSWORD=

# Public application access token (required; public SaaS-isolation material).
# The committed per-profile value lives in `.env.<profile-id>`.
SDKWORK_ACCESS_TOKEN=

# --- Deploy application identity anchor (required build and runtime input) ---
# The public application access token's `app_id`/`aud` are this installation's
# deploy application id, not a repository-owned runtime id: IAM suppresses a token
# carrying the retired runtime app id. Export the anchor on the build host before
# `pnpm workflow:materialize-client-env`, which rewrites every committed client env
# profile of the declared surfaces with it, and keep it set at runtime.
# The materializer fails, naming this variable, when it is unset or empty, so a
# build can never fall back to a compiled-in application id.
SDKWORK_DEPLOY_APPLICATION_ID=
