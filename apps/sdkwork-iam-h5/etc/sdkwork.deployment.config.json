{
  "schemaVersion": 1,
  "kind": "sdkwork.component-deployment",
  "application": "sdkwork-iam-h5",
  "parentDeploymentConfig": "../../../etc/sdkwork.deployment.config.json",
  "parentTopologySpec": "../../../specs/topology.spec.json",
  "materialization": {
    "authority": "../../../etc/sdkwork.deployment.config.json",
    "command": "pnpm exec sdkwork-app build",
    "format": "json",
    "output": "../public/runtime-env.json",
    "outputPattern": "../config/browser/runtime-env.{deploymentProfile}.{environment}.json",
    "profiles": [
      "standalone.development",
      "standalone.test",
      "standalone.staging",
      "standalone.demo",
      "standalone.production",
      "cloud.development",
      "cloud.test",
      "cloud.staging",
      "cloud.demo",
      "cloud.production"
    ],
    "runtimeTarget": "browser",
    "checkedIn": true
  },
  "profiles": {
    "standalone.development": {
      "source": "../config/browser/runtime-env.standalone.development.json"
    },
    "standalone.test": {
      "source": "../config/browser/runtime-env.standalone.test.json"
    },
    "standalone.staging": {
      "source": "../config/browser/runtime-env.standalone.staging.json"
    },
    "standalone.demo": {
      "source": "../config/browser/runtime-env.standalone.demo.json"
    },
    "standalone.production": {
      "source": "../config/browser/runtime-env.standalone.production.json"
    },
    "cloud.development": {
      "source": "../config/browser/runtime-env.cloud.development.json"
    },
    "cloud.test": {
      "source": "../config/browser/runtime-env.cloud.test.json"
    },
    "cloud.staging": {
      "source": "../config/browser/runtime-env.cloud.staging.json"
    },
    "cloud.demo": {
      "source": "../config/browser/runtime-env.cloud.demo.json"
    },
    "cloud.production": {
      "source": "../config/browser/runtime-env.cloud.production.json"
    }
  }
}
