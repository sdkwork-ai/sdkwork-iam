{
  "name": "sdkwork-iam-h5",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm dev:standalone",
    "dev:standalone": "pnpm exec sdkwork-app dev --root ../.. --deployment-profile standalone",
    "dev:cloud": "pnpm exec sdkwork-app dev --root ../.. --deployment-profile cloud",
    "stop": "pnpm exec sdkwork-app stop --root ../..",
    "build": "pnpm exec sdkwork-app build",
    "test": "pnpm exec sdkwork-app test",
    "check": "pnpm exec sdkwork-app check",
    "verify": "pnpm exec sdkwork-app verify",
    "clean": "pnpm exec sdkwork-app clean",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:config": "node ../../../sdkwork-specs/tools/check-app-manifest-standard.mjs --root . && node ../../../sdkwork-specs/tools/check-source-config-standard.mjs --root .",
    "build:dev": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment dev",
    "build:dev:cloud": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment dev --deployment-profile cloud",
    "_sdkwork:build": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment dev",
    "_sdkwork:test": "node --test tests/*.test.mjs",
    "_sdkwork:check": "pnpm run typecheck && pnpm run test:config",
    "_sdkwork:verify": "pnpm run _sdkwork:check && pnpm run _sdkwork:test",
    "_sdkwork:clean": "node -e \"const fs = require('node:fs'); fs.rmSync('dist', { recursive: true, force: true });\""
  },
  "dependencies": {
    "@sdkwork/iam-h5-core": "workspace:*",
    "@sdkwork/iam-h5-commons": "workspace:*",
    "@sdkwork/iam-h5-shell": "workspace:*",
    "@sdkwork/iam-h5-capacitor": "workspace:*",
    "@sdkwork/iam-h5-console-core": "workspace:*",
    "@sdkwork/iam-h5-console-shell": "workspace:*",
    "@sdkwork/iam-h5-admin-core": "workspace:*",
    "@sdkwork/iam-h5-admin-shell": "workspace:*",
    "@sdkwork/iam-h5-auth": "workspace:*",
    "@sdkwork/iam-h5-user-center": "workspace:*",
    "@sdkwork/iam-h5-account-binding": "workspace:*",
    "@sdkwork/iam-h5-user": "workspace:*",
    "@sdkwork/iam-h5-tenant": "workspace:*",
    "@sdkwork/iam-h5-organization": "workspace:*",
    "@sdkwork/iam-h5-oauth": "workspace:*",
    "@sdkwork/iam-h5-console-tenant": "workspace:*",
    "@sdkwork/iam-h5-console-organization": "workspace:*",
    "@sdkwork/iam-h5-console-account-binding": "workspace:*",
    "@sdkwork/iam-h5-console-user-center": "workspace:*",
    "@sdkwork/iam-h5-admin-oauth": "workspace:*",
    "@sdkwork/iam-h5-admin-tenant": "workspace:*",
    "@sdkwork/iam-h5-admin-organization": "workspace:*",
    "@sdkwork/iam-h5-admin-permission": "workspace:*",
    "@sdkwork/iam-h5-admin-account-binding": "workspace:*",
    "@sdkwork/iam-h5-admin-user": "workspace:*",
    "@sdkwork/iam-h5-admin-audit": "workspace:*",
    "@sdkwork/app-topology": "workspace:*",
    "@sdkwork/iam-contracts": "workspace:*",
    "@sdkwork/iam-service": "workspace:*",
    "@sdkwork/sdk-common": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
